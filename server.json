{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.br8n/mcp",
  "description": "Owned, portable working memory: a plain-files markdown brain any model can read and cite.",
  "repository": {
    "url": "https://github.com/Branded-Mayhem-Collective-LLC/br8n",
    "source": "github"
  },
  "websiteUrl": "https://br8n.io",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@br8n/mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "name": "brain_path",
          "description": "Path to the brain folder (markdown files). Defaults to ./brain",
          "isRequired": false,
          "valueHint": "/path/to/my-brain"
        }
      ]
    }
  ]
}
